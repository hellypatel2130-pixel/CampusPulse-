@model UserRole.Models.Post

<div class="post-card mb-5" id="post-@Model.Id">

    <!-- ========================= -->
    <!-- HEADER -->
    <!-- ========================= -->

    <div class="post-header">

        <div class="d-flex align-items-center">

            <div class="profile-wrapper">

                <img src="@(string.IsNullOrWhiteSpace(Model.Users?.ProfilePicture)
                                         ? "/images/default-user.png"
                                         : Model.Users.ProfilePicture)"
                     class="profile-image" />

                <span class="online-indicator"></span>

            </div>

            <div class="ms-3 flex-grow-1">

                <div class="d-flex align-items-center">

                    <h5 class="author-name mb-0">
                        @(Model.Users?.FullName ?? "Unknown User")
                    </h5>

                    <span class="verified-badge ms-2">
                        <i class="fa-solid fa-circle-check"></i>
                    </span>

                </div>

                <div class="author-info">

                    @if (!User.IsInRole("Admin"))
                    {
                        @if (!string.IsNullOrWhiteSpace(Model.Users?.Department))
                        {
                            <span>
                                <i class="fa-solid fa-building-columns"></i>
                                @Model.Users.Department
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Users?.EnrollmentNo))
                        {
                            <span class="ms-3">
                                <i class="fa-solid fa-id-card"></i>
                                @Model.Users.EnrollmentNo
                            </span>
                        }
                    }

                </div>
                <small class="post-time">

                    <i class="fa-regular fa-clock"></i>

                    @Model.CreatedAt.ToString("dd MMM yyyy • hh:mm tt")

                </small>

            </div>

           
        </div>

    </div>

    <!-- ========================= -->
    <!-- CAPTION -->
    <!-- ========================= -->
    @if (!string.IsNullOrWhiteSpace(Model.Caption))
    {
        <div class="post-caption">

            @Model.Caption

        </div>
    }

    <!-- ========================= -->
    <!-- MEDIA -->
    <!-- ========================= -->

    <div class="post-media">

        <partial name="_MediaViewer" model="Model" />

    </div>

    <!-- ========================= -->
    <!-- STATS -->
    <!-- ========================= -->

    <div class="post-stats">

        <div class="stat-item">

            ❤️

            <strong>

                @(Model.Likes?.Count ?? 0)

            </strong>

            Likes

        </div>

        <div class="stat-item">

            💬

            <strong>

                @(Model.Comments?.Count ?? 0)

            </strong>

            Comments

        </div>

    </div>

    <!-- ========================= -->
    <!-- ACTIONS -->
    <!-- ========================= -->

    <div class="post-actions-wrapper">

        <partial name="_PostActions" model="Model" />

    </div>

    <!-- ========================= -->
    <!-- COMMENTS -->
    <!-- ========================= -->

    <div class="post-comments">

        <partial name="_CommentSection" model="Model" />

    </div>

</div>

<style>

    .post-card {
        position: relative;
        overflow: hidden;
        border-radius: 30px;
        background: rgba(255,255,255,.75);
        backdrop-filter: blur(25px);
        border: 1px solid rgba(255,255,255,.5);
        box-shadow: 0 20px 45px rgba(0,0,0,.08), 0 5px 20px rgba(79,70,229,.08);
        transition: .45s;
    }

        .post-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 35px 80px rgba(99,102,241,.22);
        }

        .post-card::before {
            content: "";
            position: absolute;
            inset: 0;
            padding: 2px;
            border-radius: 30px;
            background: linear-gradient( 135deg, #6E9E6A, #8b5cf6, #06b6d4, #6E9E6A);
            background-size: 300%;
            animation: borderMove 8s linear infinite;
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            pointer-events: none;
        }

    @@keyframes borderMove {

        0% {
            background-position: 0%;
        }

        100% {
            background-position: 300%;
        }
    }

    .post-header {
        padding: 26px;
        background: linear-gradient( 135deg, rgba(255,255,255,.95), rgba(248,250,255,.95));
    }

    .profile-wrapper {
        position: relative;
    }

    .profile-image {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid white;
        box-shadow: 0 15px 30px rgba(0,0,0,.15);
        transition: .4s;
    }

        .profile-image:hover {
            transform: scale(1.08) rotate(4deg);
        }

    .online-indicator {
        position: absolute;
        right: 2px;
        bottom: 2px;
        width: 17px;
        height: 17px;
        background: #22c55e;
        border-radius: 50%;
        border: 3px solid white;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {

        0% {
            box-shadow: 0 0 0 0 rgba(34,197,94,.5);
        }

        70% {
            box-shadow: 0 0 0 12px rgba(34,197,94,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(34,197,94,0);
        }
    }

    .author-name {
        font-size: 20px;
        font-weight: 700;
        color: #222;
    }

    .verified-badge {
        color: #3b82f6;
        font-size: 18px;
    }

    .author-info {
        margin-top: 4px;
        font-size: 13px;
        color: #777;
    }

        .author-info i {
            color: #6E9E6A;
            margin-right: 5px;
        }

    .post-time {
        color: #999;
        font-size: 13px;
    }

   

    .post-caption {
        padding: 24px 28px;
        font-size: 17px;
        line-height: 1.9;
        color: #333;
    }

    .post-media {
        background: #f8fbff;
    }

    .post-stats {
        display: flex;
        justify-content: space-between;
        padding: 18px 28px;
        background: white;
        border-top: 1px solid #edf1f5;
        font-weight: 600;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 15px;
    }

    .post-actions-wrapper {
        padding: 8px 18px;
        background: #fbfcff;
        border-top: 1px solid #edf1f5;
    }

    .post-comments {
        padding: 25px;
        background: #fafcff;
    }

    @@media (max - width:768px) {

        .post-card {
            border-radius: 22px;
        }

        .post-header {
            padding: 18px;
        }

        .profile-image {
            width: 58px;
            height: 58px;
        }

        .post-caption {
            padding: 18px;
            font-size: 15px;
        }

        .post-comments {
            padding: 18px;
        }
    }

</style>
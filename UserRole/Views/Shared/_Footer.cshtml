<footer class="cc-footer">

    <!-- Wave -->

    <div class="footer-wave">
        <svg viewBox="0 0 1440 160" preserveAspectRatio="none">
            <path fill="currentColor"
                  d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,58.7C1120,64,1280,96,1360,112L1440,128L1440,160L0,160Z">
            </path>
        </svg>
    </div>

    <div class="container">

        <div class="row gy-5">

            <!-- Brand -->

            <div class="col-lg-3 col-md-6">

                <h3 class="footer-logo">

                    <i class="fa-solid fa-graduation-cap"></i>

                    CampusPulse+

                </h3>

                <p class="footer-text">

                    Connect, collaborate and grow with your college community.

                    Share ideas, create posts, chat with friends and learn together.

                </p>

            </div>

            <!-- Quick Links -->

            <div class="col-lg-3 col-md-6">

                <h5>

                    Quick Links

                </h5>

                <ul>

                    <li>

                        <a asp-controller="Home"
                           asp-action="Index">

                            Home

                        </a>

                    </li>

                    <li>

                        <a asp-controller="Post"
                           asp-action="Feed">

                            Feed

                        </a>

                    </li>

                    <li>

                        <a asp-controller="Post"
                           asp-action="Create">

                            Create Post

                        </a>

                    </li>

                    <li>

                        <a asp-controller="Profile"
                           asp-action="Index">

                            Profile

                        </a>

                    </li>

                </ul>

            </div>

            <!-- Community -->

            <div class="col-lg-3 col-md-6">

                <h5>

                    Community

                </h5>

                <ul>

                   
                    <li>

                        <a asp-controller="Notification"
                           asp-action="Index">

                            Notifications

                        </a>

                    </li>

                    <li>

                        <a asp-controller="Follow"
                           asp-action="Requests">

                            Follow Requests

                        </a>

                    </li>

                  

                </ul>

            </div>

            <!-- Contact -->

            <div class="col-lg-3 col-md-6">

                <h5>

                    Follow Us

                </h5>

                

                <div class="footer-contact">

                    <p>

                        <i class="fa-brands fa-instagram"></i>

                        @@CampusPulse

                    </p>

                    <p>

                        <i class="fa-solid fa-envelope"></i>

                        support@CampusPulse.com

                    </p>

                    <p>

                        <i class="fa-solid fa-location-dot"></i>

                        India

                    </p>

                </div>

            </div>

        </div>

        <hr>

        <div class="footer-bottom">

            <div>

                © @DateTime.Now.Year CampusPulse+

            </div>

            <div>

                Built with ❤️ for Students

            </div>

        </div>

    </div>

</footer>
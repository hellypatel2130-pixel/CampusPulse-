@{
    ViewData["Title"] = "CampusPulse+";
}

<!-- ===========================================================
   PREMIUM HERO SECTION
============================================================ -->

<section class="cp-hero">

    <!-- Background -->
    <div class="cp-bg-shape shape-1"></div>
    <div class="cp-bg-shape shape-2"></div>
    <div class="cp-bg-grid"></div>

    <div class="container">

        <div class="row align-items-center">

            <!-- LEFT -->
            <div class="col-lg-6">

                <span class="cp-badge">

                    <i class="fa-solid fa-sparkles"></i>

                    Modern Digital Campus

                </span>

                <h1 class="cp-title mt-4">

                    Connect.

                    <span>Collaborate.</span>

                    Create Your

                    Future.

                </h1>

                <p class="cp-desc">

                    CampusPulse+ brings your entire college community
                    together in one intelligent platform where students
                    collaborate, share resources, communicate instantly,
                    discover opportunities and grow together.

                </p>

                <div class="d-flex flex-wrap gap-3 mt-5">

                    @if (!User.Identity!.IsAuthenticated)
                    {
                        <a asp-controller="Account"
                           asp-action="Register"
                           class="btn cp-btn-primary">

                            <i class="fa-solid fa-user-plus"></i>

                            Get Started

                        </a>

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn cp-btn-secondary">

                            <i class="fa-solid fa-right-to-bracket"></i>

                            Login

                        </a>
                    }
                    else
                    {
                        <a asp-controller="Post"
                           asp-action="Feed"
                           class="btn cp-btn-primary">

                            <i class="fa-solid fa-compass"></i>

                            Explore Feed

                        </a>
                    }

                </div>

                <!-- TRUST -->

                <div class="cp-trust">

                    <div class="cp-avatars">

                        <span>A</span>
                        <span>S</span>
                        <span>R</span>
                        <span>+</span>

                    </div>

                    <div>

                        <strong>@ViewBag.TotalUsers+ Students</strong>

                        <small>already using CampusPulse+</small>

                    </div>

                </div>

            </div>

            <!-- RIGHT -->

            <div class="col-lg-6 mt-5 mt-lg-0">

                <div class="cp-dashboard">

                    <!-- TOP -->

                    <div class="cp-topbar">

                        <span></span>
                        <span></span>
                        <span></span>

                    </div>

                    <!-- PROFILE -->

                    <div class="cp-profile">

                        <div class="cp-profile-img">

                            <i class="fa-solid fa-user-graduate"></i>

                        </div>

                        <div>

                            <h5>

                                Campus Community

                            </h5>

                            <p>

                                Collaboration Dashboard

                            </p>

                        </div>

                    </div>

                    <!-- LIVE CARD -->

                    <div class="cp-live-card">

                        <div>

                            <small>Active Students</small>

                            <h3>@ViewBag.TotalUsers+</h3>

                        </div>

                        <i class="fa-solid fa-users"></i>

                    </div>

                    <div class="cp-live-card">

                        <div>

                            <small>Posts Shared</small>

                            <h3>@ViewBag.TotalPosts+</h3>

                        </div>

                        <i class="fa-solid fa-image"></i>

                    </div>

                    <div class="cp-live-card">

                        <div>

                            <small>Discussions</small>

                            <h3>24 / 7</h3>

                        </div>

                        <i class="fa-solid fa-comments"></i>

                    </div>

                   
                </div>

            </div>

        </div>

    </div>

</section>

<!-- ===========================================================
 WHY CAMPUSPULSE+
=========================================================== -->


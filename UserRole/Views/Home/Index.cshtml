<!-- ===========================================================
 FAQ
=========================================================== -->

<section class="cp-faq">

    <div class="container">

        <div class="cp-heading text-center">

            <span class="cp-section-badge">
                FAQ
            </span>

            <h2>

                Frequently Asked Questions

            </h2>

            <p>

                Everything you need to know about CampusPulse+.

            </p>

        </div>

        <div class="accordion cp-accordion" id="faqAccordion">

            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#cpfaq1">

                        Is CampusPulse+ free to use?

                    </button>

                </h2>

                <div id="cpfaq1"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#faqAccordion">

                    <div class="accordion-body">

                        Yes. The platform is completely free for students
                        and faculty members.

                    </div>

                </div>

            </div>

            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#cpfaq2">

                        Which file types are supported?

                    </button>

                </h2>

                <div id="cpfaq2"
                     class="accordion-collapse collapse"
                     data-bs-parent="#faqAccordion">

                    <div class="accordion-body">

                        Images, PDFs, Word, Excel, PowerPoint,
                        ZIP files, videos and many other formats
                        are supported.

                    </div>

                </div>

            </div>

            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#cpfaq3">

                        Can students collaborate on projects?

                    </button>

                </h2>

                <div id="cpfaq3"
                     class="accordion-collapse collapse"
                     data-bs-parent="#faqAccordion">

                    <div class="accordion-body">

                        Yes. Students can create discussions,
                        exchange files, communicate and collaborate
                        together efficiently.

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ===========================================================
 PREMIUM CTA
=========================================================== -->

<section class="cp-cta">

    <div class="container">

        <div class="cp-cta-box">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <span class="cp-section-badge">

                        START TODAY

                    </span>

                    <h2>

                        Ready To Experience A Smarter Campus?

                    </h2>

                    <p>

                        Join thousands of students already collaborating,
                        learning and growing together through CampusPulse+.

                    </p>

                </div>

                <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">

                    @if (!User.Identity!.IsAuthenticated)
                    {
                        <a asp-controller="Account"
                           asp-action="Register"
                           class="btn cp-btn-primary me-2">

                            <i class="fa-solid fa-user-plus"></i>

                            Get Started

                        </a>

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn cp-btn-secondary">

                            Login

                        </a>
                    }
                    else
                    {
                        <a asp-controller="Post"
                           asp-action="Feed"
                           class="btn cp-btn-primary">

                            <i class="fa-solid fa-compass"></i>

                            Explore Feed

                        </a>
                    }

                </div>

            </div>

        </div>

    </div>

</section>

<partial name="_Footer" />

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

}
<script>

    /*=========================================================
    DOM REFERENCES
    =========================================================*/

    const mediaInput = document.getElementById("mediaInput");
    const uploadZone = document.getElementById("uploadZone");

    const previewImage = document.getElementById("previewImage");
    const previewVideo = document.getElementById("previewVideo");
    const filePreview = document.getElementById("filePreview");

    const captionBox = document.getElementById("captionBox");
    const characterCount = document.getElementById("characterCount");

    const aiButton = document.getElementById("aiCaptionButton");
    const loadingText = document.getElementById("loadingText");

    let previousURL = null;

    /*=========================================================
    INITIALIZE
    =========================================================*/

    document.addEventListener("DOMContentLoaded", () => {

    initializeCharacterCounter();

    initializeAutoGrow();

    bindUploadEvents();

    resetPreview();

    });

    /*=========================================================
    CHARACTER COUNTER
    =========================================================*/

    function initializeCharacterCounter() {

    updateCharacterCounter();

    captionBox.addEventListener("input", () => {

    updateCharacterCounter();

    });

    }

    function updateCharacterCounter() {

    const length = captionBox.value.length;

    characterCount.textContent = length;

    if (length < 1000) {

        characterCount.style.color = "#A8D1A3";

    }
    else if (length < 1400) {

    characterCount.style.color = "#f59e0b";

    }
    else {

    characterCount.style.color = "#ef4444";

    }

    }

    /*=========================================================
    AUTO GROW TEXTAREA
    =========================================================*/

    function initializeAutoGrow() {

    autoGrow();

    captionBox.addEventListener("input", autoGrow);

    }

    function autoGrow() {

    captionBox.style.height = "auto";

    captionBox.style.height = captionBox.scrollHeight + "px";

    }

    /*=========================================================
    FILE EVENTS
    =========================================================*/

    function bindUploadEvents() {

    mediaInput.addEventListener("change", handleFileSelection);

    }

    /*=========================================================
    FILE SELECT
    =========================================================*/

    function handleFileSelection(e) {

    const file = e.target.files[0];

    resetPreview();

    if (!file)
    return;

    if (previousURL)
    URL.revokeObjectURL(previousURL);

    previousURL = URL.createObjectURL(file);

    renderPreview(file);

    }

    /*=========================================================
    RESET PREVIEW
    =========================================================*/

    function resetPreview() {

    previewImage.style.display = "none";
    previewVideo.style.display = "none";

    previewImage.removeAttribute("src");
    previewVideo.removeAttribute("src");

    filePreview.innerHTML = `

    <div class="empty-preview">

    <i class="fa-regular fa-image"></i>

    <h5>Nothing to Preview</h5>

    <p>

    Upload a file to see a live preview here.

    </p>

    </div>

    `;

    }

    /*=========================================================
    ANIMATE ELEMENT
    =========================================================*/

    function animateElement(element) {

    element.animate(

    [

    {
    opacity:0,
    transform:"translateY(20px) scale(.95)"
    },

    {
    opacity:1,
    transform:"translateY(0) scale(1)"
    }

    ],

    {

    duration:400,

    easing:"ease-out"

    }

    );

    }
/*=========================================================
    PREVIEW RENDERER
=========================================================*/

function renderPreview(file) {

    const type = file.type;

    if (type.startsWith("image/")) {

        showImagePreview();

        return;
    }

    if (type.startsWith("video/")) {

        showVideoPreview();

        return;
    }

    showFileCard(file);

}

/*=========================================================
    IMAGE PREVIEW
=========================================================*/

function showImagePreview() {

    filePreview.innerHTML = "";

    previewImage.src = previousURL;

    previewImage.style.display = "block";

    animateElement(previewImage);

}

/*=========================================================
    VIDEO PREVIEW
=========================================================*/

function showVideoPreview() {

    filePreview.innerHTML = "";

    previewVideo.src = previousURL;

    previewVideo.style.display = "block";

    animateElement(previewVideo);

}

/*=========================================================
    FILE CARD
=========================================================*/

function showFileCard(file) {

    previewImage.style.display = "none";
    previewVideo.style.display = "none";

    previewImage.removeAttribute("src");
    previewVideo.removeAttribute("src");

    const info = getFileInfo(file);

    filePreview.innerHTML = `

        <div class="file-card">

            <i class="fa-solid ${info.icon}"
               style="color:${info.color}">
            </i>

            <h4>${file.name}</h4>

            <p>${info.title}</p>

            <span class="file-size">

                ${formatFileSize(file.size)}

            </span>

        </div>

    `;

    animateElement(filePreview);

}

/*=========================================================
    FILE INFORMATION
=========================================================*/

function getFileInfo(file) {

    const ext = file.name
        .split(".")
        .pop()
        .toLowerCase();

    switch (ext) {

        case "pdf":

            return {

                icon: "fa-file-pdf",

                color: "#ef4444",

                title: "PDF Document"

            };

        case "doc":

        case "docx":

            return {

                icon: "fa-file-word",

                color: "#2563eb",

                title: "Word Document"

            };

        case "xls":

        case "xlsx":

            return {

                icon: "fa-file-excel",

                color: "#16a34a",

                title: "Excel Spreadsheet"

            };

        case "ppt":

        case "pptx":

            return {

                icon: "fa-file-powerpoint",

                color: "#ea580c",

                title: "PowerPoint Presentation"

            };

        case "zip":

        case "rar":

        case "7z":

            return {

                icon: "fa-file-zipper",

                color: "#64748b",

                title: "Compressed Archive"

            };

        case "txt":

            return {

                icon: "fa-file-lines",

                color: "#0f172a",

                title: "Text File"

            };

        case "csv":

            return {

                icon: "fa-file-csv",

                color: "#15803d",

                title: "CSV File"

            };

        case "mp3":

        case "wav":

        case "aac":

            return {

                icon: "fa-file-audio",

                color: "#0ea5e9",

                title: "Audio File"

            };

        default:

            return {

                icon: "fa-file",

                    color: "#6E9E6A",

                title: "Document"

            };

    }

}

/*=========================================================
    FILE SIZE FORMATTER
=========================================================*/

function formatFileSize(bytes) {

    if (bytes === 0)
        return "0 Bytes";

    const units = [

        "Bytes",
        "KB",
        "MB",
        "GB",
        "TB"

    ];

    const index = Math.floor(
        Math.log(bytes) / Math.log(1024)
    );

    return (

        bytes /
        Math.pow(1024, index)

    ).toFixed(2) +

    " " +

    units[index];

}
    /*=========================================================
        DRAG & DROP
    =========================================================*/

    ["dragenter", "dragover"].forEach(eventName => {

        uploadZone.addEventListener(eventName, e => {

            e.preventDefault();
            e.stopPropagation();

            uploadZone.classList.add("active");

        });

    });

    ["dragleave", "drop"].forEach(eventName => {

        uploadZone.addEventListener(eventName, e => {

            e.preventDefault();
            e.stopPropagation();

            uploadZone.classList.remove("active");

        });

    });

    uploadZone.addEventListener("drop", e => {

        if (!e.dataTransfer.files.length)
            return;

        mediaInput.files = e.dataTransfer.files;

        mediaInput.dispatchEvent(new Event("change"));

    });

    /*=========================================================
        AI CAPTION
    =========================================================*/

    if (aiButton) {

        aiButton.addEventListener("click", generateAICaption);

    }

    async function generateAICaption() {

        if (mediaInput.files.length === 0) {

            Swal.fire({

                icon: "warning",

                title: "No Media Selected",

                text: "Please upload a file first."

            });

            return;

        }

        loadingText.style.display = "flex";

        aiButton.disabled = true;

        aiButton.innerHTML = `
            <span class="spinner-border spinner-border-sm"></span>
            Generating...
        `;

        const formData = new FormData();

        formData.append("file", mediaInput.files[0]);

        try {

            const response = await fetch("/Post/GenerateCaption", {

                method: "POST",

                body: formData

            });

            const result = await response.json();

            loadingText.style.display = "none";

            aiButton.disabled = false;

            aiButton.innerHTML = `
                <i class="fa-solid fa-robot"></i>
                Generate AI Caption
            `;

            if (result.success) {

                await typeWriter(result.caption);

                Swal.fire({

                    icon: "success",

                    title: "Caption Generated",

                    text: "AI generated a professional caption.",

                    timer: 1800,

                    showConfirmButton: false

                });

            }
            else {

                Swal.fire({

                    icon: "error",

                    title: "AI Error",

                    text: result.caption

                });

            }

        }
        catch {

            loadingText.style.display = "none";

            aiButton.disabled = false;

            aiButton.innerHTML = `
                <i class="fa-solid fa-robot"></i>
                Generate AI Caption
            `;

            Swal.fire({

                icon: "error",

                title: "Server Error",

                text: "Unable to connect to AI service."

            });

        }

    }

    /*=========================================================
        TYPEWRITER EFFECT
    =========================================================*/

    async function typeWriter(text) {

        captionBox.value = "";

        updateCharacterCounter();

        for (let i = 0; i < text.length; i++) {

            captionBox.value += text.charAt(i);

            updateCharacterCounter();

            autoGrow();

            await sleep(12);

        }

    }

    function sleep(ms) {

        return new Promise(resolve => setTimeout(resolve, ms));

    }

    /*=========================================================
        RESET
    =========================================================*/

    const form = document.getElementById("createPostForm");

    form.addEventListener("reset", () => {

        setTimeout(() => {

            if (previousURL) {

                URL.revokeObjectURL(previousURL);

                previousURL = null;

            }

            resetPreview();

            captionBox.style.height = "auto";

            updateCharacterCounter();

            loadingText.style.display = "none";

        }, 50);

    });

    /*=========================================================
        IMAGE / VIDEO LOAD ANIMATION
    =========================================================*/

    previewImage.onload = () => {

        animateElement(previewImage);

    };

    previewVideo.onloadeddata = () => {

        animateElement(previewVideo);

    };

    /*=========================================================
        PREVENT DOUBLE SUBMIT
    =========================================================*/

    form.addEventListener("submit", function () {

        const submitButton = document.querySelector(".btn-publish");

        submitButton.disabled = true;

        submitButton.innerHTML = `

            <span class="spinner-border spinner-border-sm me-2"></span>

            Publishing...

        `;

    });

    /*=========================================================
        INITIAL ANIMATION
    =========================================================*/

    window.addEventListener("load", () => {

        document
            .querySelectorAll(".studio-card")
            .forEach((card, index) => {

                card.animate(

                    [

                        {
                            opacity: 0,
                            transform: "translateY(35px)"
                        },

                        {
                            opacity: 1,
                            transform: "translateY(0)"
                        }

                    ],

                    {

                        duration: 500,

                        delay: index * 120,

                        easing: "ease-out",

                        fill: "both"

                    }

                );

            });

    });

    /*=========================================================
        END OF SCRIPT
    =========================================================*/

</script>

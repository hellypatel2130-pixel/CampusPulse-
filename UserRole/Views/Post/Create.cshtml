@model UserRole.ViewModel.CreatePostViewModel

@{
    ViewData["Title"] = "AI Content Studio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css"/>

<div class="content-studio">

    <div class="container-fluid px-0">

        <!-- ========================================= -->
        <!-- HERO -->
        <!-- ========================================= -->

        <section class="studio-hero">

            <div class="hero-left">

                <span class="hero-badge">

                    <i class="fa-solid fa-sparkles"></i>

                    AI Powered Content Studio

                </span>

                <h1>

                    Create Beautiful Campus Posts

                </h1>

                <p>

                    Publish announcements, achievements, events,
                    notices and updates with a modern publishing
                    experience powered by Artificial Intelligence.

                </p>

                <div class="hero-features">

                    <div class="feature-chip">

                        <i class="fa-solid fa-wand-magic-sparkles"></i>

                        AI Caption

                    </div>

                    <div class="feature-chip">

                        <i class="fa-solid fa-images"></i>

                        Live Preview

                    </div>

                    <div class="feature-chip">

                        <i class="fa-solid fa-cloud-arrow-up"></i>

                        Smart Upload

                    </div>

                    <div class="feature-chip">

                        <i class="fa-solid fa-shield-heart"></i>

                        Secure Publishing

                    </div>

                </div>

            </div>

            <div class="hero-right">

                <div class="hero-icon">

                    <i class="fa-solid fa-photo-film"></i>

                </div>

            </div>

        </section>

        <!-- ========================================= -->
        <!-- FORM -->
        <!-- ========================================= -->

        <form method="post"
              enctype="multipart/form-data"
              id="createPostForm">

            @Html.AntiForgeryToken()

            <div class="row g-4 mt-1">

                <!-- ================================= -->
                <!-- LEFT COLUMN -->
                <!-- ================================= -->

                <div class="col-xl-7">

                    <div class="studio-card">

                        <div class="card-header-modern">

                            <div>

                                <h3>

                                    <i class="fa-solid fa-pen-nib"></i>

                                    Write Your Caption

                                </h3>

                                <p>

                                    Tell your audience what this post is about.

                                </p>

                            </div>

                            <div class="header-icon">

                                <i class="fa-solid fa-align-left"></i>

                            </div>

                        </div>

                        <div class="card-body-modern">

                            <label asp-for="Caption"
                                   class="modern-label">

                                Caption

                            </label>

                            <textarea asp-for="Caption"
                                      id="captionBox"
                                      class="modern-textarea"
                                      rows="10"
                                      maxlength="1500"
                                      placeholder="Share campus news, events, achievements, notices or anything exciting..."></textarea>

                            <span asp-validation-for="Caption"
                                  class="text-danger small"></span>

                            <div class="caption-footer">

                                <div class="character-counter">

                                    <i class="fa-regular fa-keyboard"></i>

                                    <span id="characterCount">

                                        0

                                    </span>

                                    /1500 Characters

                                </div>

                                <button type="button"
                                        id="aiCaptionButton"
                                        class="btn-ai">

                                    <i class="fa-solid fa-robot"></i>

                                    Generate AI Caption

                                </button>

                            </div>

                            <div id="loadingText"
                                 class="ai-loading">

                                <div class="spinner-border spinner-border-sm">

                                </div>

                                <span>

                                    AI is writing a professional caption...

                                </span>

                            </div>

                        </div>

                    </div>

                </div>
                <!-- ================================= -->
                <!-- RIGHT COLUMN -->
                <!-- ================================= -->

                <div class="col-xl-5">

                    <!-- Upload Card -->

                    <div class="studio-card mb-4">

                        <div class="card-header-modern">

                            <div>

                                <h3>

                                    <i class="fa-solid fa-cloud-arrow-up"></i>

                                    Upload Media

                                </h3>

                                <p>

                                    Images, Videos, PDF, Word, Excel, PPT, ZIP.

                                </p>

                            </div>

                            <div class="header-icon">

                                <i class="fa-solid fa-file-arrow-up"></i>

                            </div>

                        </div>

                        <div class="card-body-modern">

                            <div class="upload-zone"
                                 id="uploadZone">

                                <input asp-for="MediaFile"
                                       type="file"
                                       id="mediaInput"
                                       hidden />

                                <div class="upload-icon">

                                    <i class="fa-solid fa-cloud-arrow-up"></i>

                                </div>

                                <h4>

                                    Drag & Drop Files

                                </h4>

                                <p>

                                    or click below to browse files

                                </p>

                                <button type="button"
                                        class="browse-btn"
                                        onclick="document.getElementById('mediaInput').click()">

                                    <i class="fa-solid fa-folder-open"></i>

                                    Browse Files

                                </button>

                                <small>

                                    Maximum file size depends on server configuration.

                                </small>

                            </div>

                            <span asp-validation-for="MediaFile"
                                  class="text-danger mt-2 d-block">
                            </span>

                        </div>

                    </div>

                    <!-- Preview Card -->

                    <div class="studio-card">

                        <div class="card-header-modern">

                            <div>

                                <h3>

                                    <i class="fa-solid fa-eye"></i>

                                    Live Preview

                                </h3>

                                <p>

                                    Instantly preview the uploaded content.

                                </p>

                            </div>

                            <div class="header-icon">

                                <i class="fa-solid fa-photo-film"></i>

                            </div>

                        </div>

                        <div class="card-body-modern">

                            <div class="preview-wrapper">

                                <img id="previewImage"
                                     class="preview-image"
                                     alt="Preview" />

                                <video id="previewVideo"
                                       controls
                                       class="preview-video">
                                </video>

                                <div id="filePreview"
                                     class="file-preview">

                                    <div class="empty-preview">

                                        <i class="fa-regular fa-image"></i>

                                        <h5>

                                            Nothing to Preview

                                        </h5>

                                        <p>

                                            Upload a file to see a live preview here.

                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- ===================================== -->
            <!-- ACTION BAR -->
            <!-- ===================================== -->

            <div class="publish-section mt-4">

                <div class="publish-left">

                    <button type="reset"
                            class="btn-reset">

                        <i class="fa-solid fa-rotate-left"></i>

                        Reset

                    </button>

                    <a asp-controller="Post"
                       asp-action="Feed"
                       class="btn-feed">

                        <i class="fa-solid fa-images"></i>

                        Open Feed

                    </a>

                </div>

                <div class="publish-right">

                    <button type="submit"
                            class="btn-publish">

                        <i class="fa-solid fa-paper-plane"></i>

                        Publish Post

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>


<style>
/*=========================================================
    CampusPulse+ AI CONTENT STUDIO
=========================================================*/

:root{

--primary:#6E9E6A;
--primary-dark:#A8D1A3;

--secondary:#8b5cf6;
--pink:#ec4899;
--cyan:#06b6d4;
--green:#10b981;
--orange:#f59e0b;
--red:#ef4444;

--bg:#f4f7ff;
--surface:#ffffff;

--text:#111827;
--text-light:#6b7280;

--border:#e5e7eb;

--shadow-sm:
0 8px 20px rgba(15,23,42,.06);

--shadow:
0 18px 45px rgba(99,102,241,.10);

--shadow-lg:
0 35px 80px rgba(79,70,229,.18);

--glass:
rgba(255,255,255,.78);

--radius:24px;

--transition:.35s ease;

}

/*=========================================================
BODY
=========================================================*/

html{

scroll-behavior:smooth;

}

body{

font-family:'Poppins',sans-serif;

color:var(--text);

background:

radial-gradient(circle at top left,#dbeafe 0,#eef5ff 32%,#f8fbff 100%);

min-height:100vh;

overflow-x:hidden;

position:relative;

}

/* Floating Background */

body::before{

content:"";

position:fixed;

width:550px;

height:550px;

border-radius:50%;

top:-220px;

right:-180px;

background:

radial-gradient(

rgba(99,102,241,.18),

transparent 70%

);

pointer-events:none;

z-index:-2;

}

body::after{

content:"";

position:fixed;

width:450px;

height:450px;

border-radius:50%;

bottom:-160px;

left:-140px;

background:

radial-gradient(

rgba(139,92,246,.16),

transparent 70%

);

pointer-events:none;

z-index:-2;

}

/*=========================================================
PAGE WRAPPER
=========================================================*/

.content-studio{

max-width:1500px;

margin:auto;

padding:45px 18px 70px;

}

/*=========================================================
HERO
=========================================================*/

.studio-hero{

display:flex;

justify-content:space-between;

align-items:center;

gap:40px;

padding:55px;

border-radius:34px;

position:relative;

overflow:hidden;

margin-bottom:35px;

color:#fff;

background:

linear-gradient(
135deg,
#A8D1A3 0%,
#7c3aed 45%,
#06b6d4 100%
);

background-size:250%;

animation:gradientFlow 10s linear infinite;

box-shadow:var(--shadow-lg);

}

.studio-hero::before{

content:"";

position:absolute;

width:650px;

height:650px;

border-radius:50%;

top:-260px;

right:-180px;

background:

rgba(255,255,255,.08);

}

.studio-hero::after{

content:"";

position:absolute;

width:420px;

height:420px;

border-radius:50%;

left:-150px;

bottom:-180px;

background:

rgba(255,255,255,.06);

}

.studio-hero>*{

position:relative;

z-index:2;

}

.hero-left{

flex:1;

}

.hero-right{

width:220px;

display:flex;

justify-content:center;

}

/*=========================================================
HERO TYPOGRAPHY
=========================================================*/

.hero-badge{

display:inline-flex;

align-items:center;

gap:10px;

padding:10px 22px;

border-radius:999px;

background:

rgba(255,255,255,.16);

backdrop-filter:blur(18px);

border:1px solid rgba(255,255,255,.25);

font-weight:600;

margin-bottom:24px;

}

.hero-badge i{

color:#ffe082;

}

.studio-hero h1{

font-size:52px;

font-weight:800;

line-height:1.1;

margin-bottom:18px;

}

.studio-hero p{

font-size:18px;

line-height:1.9;

max-width:720px;

opacity:.95;

}

/*=========================================================
FEATURE CHIPS
=========================================================*/

.hero-features{

display:flex;

flex-wrap:wrap;

gap:14px;

margin-top:30px;

}

.feature-chip{

display:flex;

align-items:center;

gap:10px;

padding:12px 20px;

border-radius:999px;

background:

rgba(255,255,255,.14);

backdrop-filter:blur(14px);

border:1px solid rgba(255,255,255,.20);

font-weight:600;

transition:var(--transition);

}

.feature-chip:hover{

transform:translateY(-4px);

background:

rgba(255,255,255,.22);

}

.feature-chip i{

color:#ffe082;

}

/*=========================================================
HERO ICON
=========================================================*/

.hero-icon{

width:180px;

height:180px;

border-radius:40px;

display:flex;

align-items:center;

justify-content:center;

background:

rgba(255,255,255,.16);

backdrop-filter:blur(25px);

border:1px solid rgba(255,255,255,.25);

box-shadow:

0 20px 50px rgba(0,0,0,.12);

}

.hero-icon i{

font-size:80px;

color:#fff;

}

/*=========================================================
GRID
=========================================================*/

#createPostForm .row{

align-items:flex-start;

}

.col-xl-7,
.col-xl-5{

display:flex;

flex-direction:column;

gap:25px;

}
/*=========================================================
STUDIO CARD
=========================================================*/

.studio-card{

position:relative;

overflow:hidden;

background:var(--glass);

backdrop-filter:blur(28px);

-webkit-backdrop-filter:blur(28px);

border:1px solid rgba(255,255,255,.55);

border-radius:30px;

box-shadow:var(--shadow);

transition:all .35s ease;

}

.studio-card:hover{

transform:translateY(-8px);

box-shadow:

0 35px 75px rgba(99,102,241,.18);

}

.studio-card::before{

content:"";

position:absolute;

inset:0;

background:

linear-gradient(
130deg,
transparent,
rgba(255,255,255,.30),
transparent
);

transform:translateX(-120%);

pointer-events:none;

}

.studio-card:hover::before{

transform:translateX(120%);

transition:1.15s;

}

/*=========================================================
CARD HEADER
=========================================================*/

.card-header-modern{

display:flex;

justify-content:space-between;

align-items:center;

padding:30px 34px;

border-bottom:1px solid rgba(226,232,240,.75);

}

.card-header-modern h3{

margin:0;

font-size:27px;

font-weight:700;

color:var(--text);

}

.card-header-modern h3 i{

margin-right:10px;

color:var(--primary);

}

.card-header-modern p{

margin-top:10px;

margin-bottom:0;

color:var(--text-light);

font-size:15px;

line-height:1.7;

}

.header-icon{

width:72px;

height:72px;

border-radius:22px;

display:flex;

align-items:center;

justify-content:center;

color:#fff;

font-size:28px;

background:

linear-gradient(
135deg,
var(--primary),
var(--secondary)
);

box-shadow:

0 15px 35px rgba(99,102,241,.25);

flex-shrink:0;

}

/*=========================================================
CARD BODY
=========================================================*/

.card-body-modern{

padding:34px;

}

/*=========================================================
LABEL
=========================================================*/

.modern-label{

display:block;

font-weight:700;

color:var(--text);

margin-bottom:15px;

font-size:15px;

letter-spacing:.3px;

}

/*=========================================================
MODERN TEXTAREA
=========================================================*/

.modern-textarea{

width:100%;

min-height:260px;

resize:none;

padding:24px;

border-radius:22px;

border:2px solid transparent;

outline:none;

background:#f7f9ff;

color:var(--text);

font-size:16px;

line-height:1.9;

transition:all .35s ease;

}

.modern-textarea::placeholder{

color:#9ca3af;

}

.modern-textarea:hover{

background:#fff;

}

.modern-textarea:focus{

background:#fff;

border-color:var(--primary);

box-shadow:

0 15px 35px rgba(99,102,241,.12);

}

/*=========================================================
CAPTION FOOTER
=========================================================*/

.caption-footer{

margin-top:22px;

display:flex;

align-items:center;

justify-content:space-between;

flex-wrap:wrap;

gap:18px;

}

/*=========================================================
CHARACTER COUNTER
=========================================================*/

.character-counter{

display:flex;

align-items:center;

gap:10px;

padding:12px 18px;

border-radius:50px;

background:#eef2ff;

color:var(--primary);

font-weight:600;

font-size:14px;

}

.character-counter i{

font-size:16px;

}

#characterCount{

font-weight:800;

font-size:15px;

color:var(--primary-dark);

}

/*=========================================================
AI BUTTON
=========================================================*/

.btn-ai{

border:none;

outline:none;

display:inline-flex;

align-items:center;

gap:12px;

padding:15px 28px;

border-radius:999px;

color:#fff;

cursor:pointer;

font-weight:700;

font-size:15px;

transition:all .35s ease;

background:

linear-gradient(
135deg,
var(--primary),
var(--secondary)
);

box-shadow:

0 18px 35px rgba(99,102,241,.25);

}

.btn-ai i{

font-size:18px;

}

.btn-ai:hover{

transform:

translateY(-3px)
scale(1.02);

box-shadow:

0 25px 45px rgba(99,102,241,.35);

}

.btn-ai:active{

transform:scale(.97);

}

/*=========================================================
AI LOADING
=========================================================*/

.ai-loading{

display:none;

align-items:center;

gap:14px;

margin-top:25px;

padding:16px 22px;

border-radius:18px;

background:#eef2ff;

color:var(--primary);

font-weight:600;

}

.ai-loading .spinner-border{

width:20px;

height:20px;

}

/*=========================================================
VALIDATION
=========================================================*/

.text-danger{

font-size:14px;

margin-top:8px;

display:block;

}
/*=========================================================
UPLOAD ZONE
=========================================================*/

.upload-zone{

position:relative;

display:flex;

flex-direction:column;

align-items:center;

justify-content:center;

text-align:center;

min-height:330px;

padding:45px 30px;

border:3px dashed #c7d2fe;

border-radius:28px;

cursor:pointer;

background:
linear-gradient(
135deg,
#f8faff,
#eef4ff
);

transition:all .35s ease;

overflow:hidden;

}

.upload-zone::before{

content:"";

position:absolute;

width:420px;

height:420px;

border-radius:50%;

background:
radial-gradient(
rgba(99,102,241,.08),
transparent 70%
);

top:-220px;

right:-170px;

pointer-events:none;

}

.upload-zone:hover{

transform:translateY(-6px);

border-color:var(--primary);

background:#ffffff;

box-shadow:
0 22px 55px rgba(99,102,241,.12);

}

.upload-zone.active{

border-style:solid;

border-color:var(--primary);

background:#eef2ff;

transform:scale(1.01);

}

/*=========================================================
UPLOAD ICON
=========================================================*/

.upload-icon{

width:95px;

height:95px;

border-radius:28px;

display:flex;

align-items:center;

justify-content:center;

margin-bottom:25px;

color:#fff;

font-size:38px;

background:
linear-gradient(
135deg,
var(--primary),
var(--secondary)
);

box-shadow:
0 20px 40px rgba(99,102,241,.22);

animation:floatIcon 3s ease-in-out infinite;

}

.upload-zone h4{

font-size:24px;

font-weight:700;

color:var(--text);

margin-bottom:10px;

}

.upload-zone p{

color:var(--text-light);

margin-bottom:20px;

line-height:1.8;

}

.upload-zone small{

color:#9ca3af;

margin-top:18px;

}

/*=========================================================
BROWSE BUTTON
=========================================================*/

.browse-btn{

border:none;

outline:none;

color:#fff;

cursor:pointer;

font-weight:700;

font-size:15px;

padding:14px 28px;

border-radius:50px;

transition:.35s;

background:
linear-gradient(
135deg,
var(--primary),
var(--secondary)
);

box-shadow:
0 18px 35px rgba(99,102,241,.20);

}

.browse-btn:hover{

transform:
translateY(-3px)
scale(1.03);

box-shadow:
0 24px 45px rgba(99,102,241,.30);

}

.browse-btn i{

margin-right:10px;

}

/*=========================================================
PREVIEW CARD
=========================================================*/

.preview-wrapper{

display:flex;

justify-content:center;

align-items:center;

min-height:340px;

border-radius:24px;

overflow:hidden;

background:
linear-gradient(
135deg,
#f9fbff,
#eef4ff
);

border:2px dashed #dbe4ff;

position:relative;

}

/*=========================================================
IMAGE PREVIEW
=========================================================*/

.preview-image{

display:none;

width:100%;

max-height:420px;

object-fit:cover;

border-radius:20px;

animation:fadePreview .45s ease;

}

/*=========================================================
VIDEO PREVIEW
=========================================================*/

.preview-video{

display:none;

width:100%;

border-radius:20px;

animation:fadePreview .45s ease;

}

/*=========================================================
FILE PREVIEW
=========================================================*/

.file-preview{

width:100%;

}

.file-card{

text-align:center;

padding:45px 25px;

}

.file-card i{

font-size:90px;

margin-bottom:20px;

}

.file-card h4{

font-size:22px;

font-weight:700;

color:var(--text);

word-break:break-word;

}

.file-card p{

margin-top:14px;

color:var(--text-light);

}

.file-size{

display:inline-block;

margin-top:18px;

padding:10px 18px;

border-radius:40px;

color:#fff;

font-weight:600;

background:
linear-gradient(
135deg,
var(--primary),
var(--secondary)
);

}

/*=========================================================
EMPTY PREVIEW
=========================================================*/

.empty-preview{

text-align:center;

padding:60px 20px;

}

.empty-preview i{

font-size:80px;

color:#c7d2fe;

margin-bottom:25px;

}

.empty-preview h5{

font-size:24px;

font-weight:700;

color:var(--text);

margin-bottom:12px;

}

.empty-preview p{

color:var(--text-light);

max-width:300px;

margin:auto;

line-height:1.8;

}

/*=========================================================
PUBLISH SECTION
=========================================================*/

.publish-section{

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:20px;

padding:28px 34px;

border-radius:28px;

background:var(--glass);

backdrop-filter:blur(22px);

border:1px solid rgba(255,255,255,.55);

box-shadow:var(--shadow);

}

.publish-left{

display:flex;

flex-wrap:wrap;

gap:15px;

}

.publish-right{

margin-left:auto;

}

/*=========================================================
BUTTONS
=========================================================*/

.btn-reset,
.btn-feed,
.btn-publish{

border:none;

outline:none;

cursor:pointer;

text-decoration:none;

display:inline-flex;

align-items:center;

justify-content:center;

gap:10px;

font-weight:700;

transition:.35s;

}

/* Reset */

.btn-reset{

padding:14px 28px;

border-radius:50px;

color:var(--text);

background:#eef2ff;

}

.btn-reset:hover{

background:#dbe4ff;

transform:translateY(-3px);

}

/* Feed */

.btn-feed{

padding:14px 28px;

border-radius:50px;

color:#fff;

background:
linear-gradient(
135deg,
var(--cyan),
var(--primary)
);

box-shadow:
0 18px 35px rgba(6,182,212,.20);

}

.btn-feed:hover{

color:#fff;

transform:
translateY(-3px);

}

/* Publish */

.btn-publish{

color:#fff;

font-size:17px;

padding:16px 40px;

border-radius:60px;

background:
linear-gradient(
135deg,
var(--green),
#16a34a
);

box-shadow:
0 22px 45px rgba(16,185,129,.25);

}

.btn-publish:hover{

transform:
translateY(-4px)
scale(1.02);

box-shadow:
0 30px 60px rgba(16,185,129,.35);

}

.btn-publish i{

font-size:18px;

}
/*=========================================================
ANIMATIONS
=========================================================*/

@@keyframes gradientFlow{

0%{
background-position:0% 50%;
}

50%{
background-position:100% 50%;
}

100%{
background-position:0% 50%;
}

}

/*----------------------------------------*/

2@keyframes floatIcon{

0%{
transform:translateY(0px);
}

50%{
transform:translateY(-10px);
}


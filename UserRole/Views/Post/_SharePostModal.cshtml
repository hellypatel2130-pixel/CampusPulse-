@model List<UserRole.Models.Users>

<div class="modal fade"
     id="sharePostModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">

                    <i class="fa-solid fa-paper-plane me-2"></i>

                    Share Post

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body">

                

                <input type="hidden"
                       id="sharePostId"
                       value="@ViewBag.PostId" />

                <div id="shareUserList">

                    @foreach (var user in Model)
                    {
                        <div class="d-flex justify-content-between align-items-center border rounded p-2 mb-2 share-user">

                            <div class="d-flex align-items-center">

                                <img src="@(string.IsNullOrWhiteSpace(user.ProfilePicture)
                                                                         ? "/images/default-user.png"
                                                                         : user.ProfilePicture)"
                                     width="45"
                                     height="45"
                                     class="rounded-circle me-3"
                                     style="object-fit:cover;" />

                                <div>

                                    <strong>@user.FullName</strong>

                                    <br />

                                    <small class="text-muted">

                                        @user.Department

                                    </small>

                                </div>

                            </div>

                            <button class="btn btn-success shareBtn"
                                    data-user="@user.Id">

                                Send

                            </button>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@{
    ViewData["Title"] = "Email Sent";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">

    <div class="account-box">

        <div class="text-center">

            <!-- SUCCESS ICON -->

            <div class="login-icon mb-4">

                <i class="fa-solid fa-paper-plane"></i>

            </div>

            <!-- TITLE -->

            <h2>

                Email Sent Successfully

            </h2>

            <p class="login-subtitle mb-4">

                We've sent a verification email to your registered email address.

            </p>

        </div>

        <!-- MESSAGE CARD -->

        <div class="alert alert-success border-0 rounded-4 shadow-sm text-center mb-4">

            <i class="fa-solid fa-envelope-circle-check fa-2x mb-3"></i>

            <h5 class="fw-bold">

                Check Your Inbox

            </h5>

            <p class="mb-2">

                A verification email has been sent successfully.

            </p>

            <p class="mb-0">

                Please open the email and click the verification link to continue.

            </p>

        </div>

        <!-- INFO -->

        <div class="text-center mb-4">

            <small class="text-light">

                <i class="fa-solid fa-circle-info me-2"></i>

                Didn't receive the email? Please check your Spam or Junk folder.

            </small>

        </div>

        <!-- BUTTON -->

        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-success w-100 goto-login">

            <i class="fa-solid fa-right-to-bracket me-2"></i>

            Back To Login

        </a>

        <!-- HOME -->

        <div class="text-center mt-4">

            <a asp-controller="Home"
               asp-action="Index"
               class="back-home">

                <i class="fa-solid fa-house me-2"></i>

                Back To Home

            </a>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
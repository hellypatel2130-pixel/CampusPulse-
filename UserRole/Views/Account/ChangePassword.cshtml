@using UserRole.ViewModel
@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">

    <div class="account-box">

        <div class="text-center mb-4">

            <div class="login-icon mb-3">

                <i class="fa-solid fa-key"></i>

            </div>

            <h2>

                Change Password

            </h2>

            <p class="login-subtitle">

                Create a strong new password to secure your account.

            </p>

        </div>

        <form asp-action="ChangePassword"
              method="post"
              autocomplete="off">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- TOKEN -->

            <input type="hidden"
                   asp-for="Token" />

            <!-- EMAIL -->

            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">

                    <i class="fa-solid fa-envelope me-2"></i>

                    Email Address

                </label>

                <input asp-for="Email"
                       class="form-control"
                       readonly />

            </div>

            <!-- NEW PASSWORD -->

            <div class="mb-3">

                <label asp-for="NewPassword"
                       class="form-label">

                    <i class="fa-solid fa-lock me-2"></i>

                    New Password

                </label>

                <input asp-for="NewPassword"
                       type="password"
                       class="form-control"
                       placeholder="Enter your new password" />

                <span asp-validation-for="NewPassword"
                      class="text-danger">
                </span>

            </div>

            <!-- CONFIRM PASSWORD -->

            <div class="mb-4">

                <label asp-for="ConfirmNewPassword"
                       class="form-label">

                    <i class="fa-solid fa-shield-halved me-2"></i>

                    Confirm Password

                </label>

                <input asp-for="ConfirmNewPassword"
                       type="password"
                       class="form-control"
                       placeholder="Confirm your new password" />

                <span asp-validation-for="ConfirmNewPassword"
                      class="text-danger">
                </span>

            </div>

            <!-- SUBMIT -->

            <button type="submit"
                    class="btn btn-success w-100">

                <i class="fa-solid fa-check me-2"></i>

                Update Password

            </button>

            <!-- DIVIDER -->

            <div class="auth-divider my-4">

                <span>

                    OR

                </span>

            </div>

            <!-- BACK -->

            <a asp-controller="Account"
               asp-action="VerifyEmail"
               class="btn btn-outline-light w-100">

                <i class="fa-solid fa-arrow-left me-2"></i>

                Back to Email Verification

            </a>

            <!-- HOME -->

            <div class="text-center mt-4">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="back-home">

                    <i class="fa-solid fa-house me-2"></i>

                    Back To Home

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@model List<UserRole.Models.Users>

@{
    ViewData["Title"] = "Discover Students";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>

    :root {
        --primary: #6E9E6A;
        --secondary: #8b5cf6;
        --success: #22c55e;
        --danger: #ef4444;
        --warning: #f59e0b;
        --dark: #111827;
        --glass: rgba(255,255,255,.82);
    }

   

    .search-page {
        max-width: 1200px;
        margin: auto;
        padding: 45px 20px;
    }

    .hero-card {
        background: linear-gradient(135deg,#6E9E6A,#8b5cf6,#ec4899);
        border-radius: 35px;
        color: white;
        padding: 45px;
        overflow: hidden;
        position: relative;
        box-shadow: 0 25px 60px rgba(99,102,241,.20);
        margin-bottom: 35px;
    }

        .hero-card::before {
            content: "";
            position: absolute;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            background: rgba(255,255,255,.10);
            top: -120px;
            right: -100px;
        }

        .hero-card h1 {
            font-size: 42px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .hero-card p {
            opacity: .92;
            font-size: 16px;
            margin: 0;
        }

    .search-box {
        background: var(--glass);
        backdrop-filter: blur(25px);
        border-radius: 30px;
        padding: 30px;
        box-shadow: 0 20px 50px rgba(0,0,0,.08);
        margin-top: -40px;
        position: relative;
        z-index: 10;
    }

    .search-input {
        height: 62px;
        border-radius: 18px;
        border: 2px solid #e5e7eb;
        padding-left: 55px;
        font-size: 16px;
        transition: .35s;
    }

        .search-input:focus {
            border-color: #6E9E6A;
            box-shadow: 0 0 0 6px rgba(99,102,241,.12);
        }

    .search-icon {
        position: absolute;
        left: 22px;
        top: 20px;
        color: #6E9E6A;
        font-size: 20px;
    }

    .search-btn {
        height: 62px;
        padding: 0 35px;
        border: none;
        border-radius: 18px;
        background: linear-gradient(135deg,#6E9E6A,#8b5cf6);
        color: white;
        font-weight: 700;
        transition: .35s;
    }

        .search-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(99,102,241,.25);
        }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 20px;
        margin: 35px 0;
    }

    .stat-card {
        background: white;
        border-radius: 25px;
        padding: 25px;
        text-align: center;
        box-shadow: 0 15px 35px rgba(0,0,0,.07);
        transition: .35s;
    }

        .stat-card:hover {
            transform: translateY(-8px);
        }

        .stat-card i {
            font-size: 34px;
            color: #6E9E6A;
            margin-bottom: 15px;
        }

        .stat-card h3 {
            font-weight: 800;
            margin-bottom: 5px;
        }

    @@media (max-width:991px) {

        .stats-row {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media (max-width:600px) {

        .stats-row {
            grid-template-columns: 1fr;
        }
    }

</style>

<div class="search-page">

    <!-- HERO -->

    <div class="hero-card">

        <h1>

            <i class="fa-solid fa-users-viewfinder"></i>

            Discover Students

        </h1>

        <p>

            Find classmates, faculty members and connect with your college community.

        </p>

    </div>

    <!-- SEARCH -->

    <div class="search-box">

        <form method="get">

            <div class="position-relative">

                <i class="fa-solid fa-magnifying-glass search-icon"></i>

                <div class="input-group">

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control search-input"
                           placeholder="Search by name, email or department..." />

                    <button class="search-btn">

                        <i class="fa-solid fa-search me-2"></i>

                        Search

                    </button>

                </div>

            </div>

        </form>

    </div>

    <!-- STATS -->

    <div class="stats-row">

        <div class="stat-card">

            <i class="fa-solid fa-users"></i>

            <h3>@Model.Count</h3>

            <small class="text-muted">

                Students Found

            </small>

        </div>

       

        <div class="stat-card">

            <i class="fa-solid fa-building-columns"></i>

            <h3>28+</h3>

            <small class="text-muted">

                Departments

            </small>

        </div>

        <div class="stat-card">

            <i class="fa-solid fa-network-wired"></i>

            <h3>24/7</h3>

            <small class="text-muted">

                Community

            </small>

        </div>

    </div>
    @foreach (var user in Model)
    {
        <div class="user-card">

            <div class="d-flex align-items-center">

                <!-- Profile Image -->

                <div class="avatar-wrapper">

                    <img src="@(string.IsNullOrWhiteSpace(user.ProfilePicture)
                                 ? "/images/default-user.png"
                                 : user.ProfilePicture)"
                         class="user-avatar" />

                    

                </div>

                <!-- User Info -->

                <div class="ms-4 flex-grow-1">

                    <div class="d-flex align-items-center flex-wrap">

                        <h4 class="user-name mb-1">

                            @user.FullName

                        </h4>

                        @if (user.Role != "Admin")
                        {
                            if (!string.IsNullOrWhiteSpace(user.Department))
                            {
                                <span class="department-badge ms-3">

                                    <i class="fa-solid fa-building-columns"></i>

                                    @user.Department

                                </span>
                            }
                        }

                    </div>

                    <div class="mb-2">

                        @if (user.IsOnline)
                        {
                            <span class="badge bg-success">
                                <i class="fa-solid fa-circle"
                                   style="font-size:8px;"></i>

                                Online
                            </span>
                        }
                        else if (user.LastSeen != null)
                        {
                            <small class="text-muted">

                                Last seen
                                @user.LastSeen.Value.ToString("dd MMM hh:mm tt")

                            </small>
                        }
                        else
                        {
                            <small class="text-muted">

                                Offline

                            </small>
                        }

                    </div>
                    <div class="user-email">

                        <i class="fa-solid fa-envelope"></i>

                        @user.Email

                    </div>

                    @if (user.Role != "Admin")
                    {
                        if (!string.IsNullOrWhiteSpace(user.EnrollmentNo))
                        {
                            <div class="user-enrollment mt-2">

                                <i class="fa-solid fa-id-card"></i>

                                Enrollment :
                                <strong>@user.EnrollmentNo</strong>

                            </div>
                        }
                    }

                    @if (!string.IsNullOrWhiteSpace(user.Bio))
                    {
                        <div class="user-bio mt-3">

                            @(
                                user.Bio.Length > 120
                                ? user.Bio.Substring(0, 120) + "..."
                                : user.Bio
                            )

                        </div>
                    }

                </div>

                <!-- Right Side -->

                <div class="text-end">

                    <a asp-controller="Profile"
                       asp-action="UserProfile"
                       asp-route-id="@user.Id"
                       class="btn profile-btn">

                        <i class="fa-solid fa-user"></i>

                        View Profile

                    </a>

                </div>

            </div>

        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-box">

            <i class="fa-solid fa-user-slash"></i>

            <h3>No Users Found</h3>

            <p>

                Try searching with another name,
                department or enrollment number.

            </p>

        </div>
    }

</div>

<style>

    .user-card {
        background: #fff;
        border-radius: 28px;
        padding: 24px;
        margin-bottom: 22px;
        box-shadow: 0 15px 45px rgba(0,0,0,.08);
        transition: .35s;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(99,102,241,.08);
    }

        .user-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 60px rgba(79,70,229,.18);
        }

        .user-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
            background: linear-gradient(180deg,#6E9E6A,#06b6d4);
        }

    .avatar-wrapper {
        position: relative;
    }

    .user-avatar {
        width: 95px;
        height: 95px;
        border-radius: 50%;
        object-fit: cover;
        border: 5px solid #fff;
        box-shadow: 0 12px 30px rgba(0,0,0,.15);
        transition: .35s;
    }

    .user-card:hover .user-avatar {
        transform: scale(1.08);
    }

  

    .user-name {
        font-weight: 800;
        color: #222;
    }

    .department-badge {
        padding: 6px 14px;
        border-radius: 30px;
        background: linear-gradient(135deg,#6E9E6A,#8b5cf6);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
    }

    .user-email {
        margin-top: 6px;
        color: #64748b;
    }

        .user-email i {
            color: #6E9E6A;
            margin-right: 8px;
        }

    .user-enrollment {
        font-size: 14px;
        color: #334155;
    }

    .user-bio {
        color: #555;
        line-height: 1.7;
    }

    .profile-btn {
        padding: 12px 24px;
        border-radius: 50px;
        background: linear-gradient(135deg,#6E9E6A,#8b5cf6);
        color: white;
        font-weight: 700;
        border: none;
        transition: .3s;
    }

        .profile-btn:hover {
            transform: translateY(-3px);
            color: white;
            box-shadow: 0 12px 25px rgba(99,102,241,.35);
        }

    .empty-box {
        background: white;
        padding: 70px 30px;
        border-radius: 30px;
        text-align: center;
        box-shadow: 0 15px 40px rgba(0,0,0,.08);
    }

        .empty-box i {
            font-size: 70px;
            color: #6E9E6A;
            margin-bottom: 20px;
        }

    @@media(max-width:768px) {

        .user-card {
            padding: 18px;
        }

        .user-avatar {
            width: 70px;
            height: 70px;
        }

        .profile-btn {
            width: 100%;
            margin-top: 20px;
        }
    }

</style>
<partial name="_Footer" />
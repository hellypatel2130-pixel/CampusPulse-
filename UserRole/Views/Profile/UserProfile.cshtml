@model UserRole.Models.Users

@{
    ViewData["Title"] = "Student Profile";

    bool isFollowing = ViewBag.IsFollowing != null && (bool)ViewBag.IsFollowing;
    bool isRequestPending = ViewBag.IsRequestPending != null && (bool)ViewBag.IsRequestPending;
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>

    body {
        background: #eef3fb;
        overflow-x: hidden;
    }

    /* ===========================
       PAGE WRAPPER
    =========================== */

    .profile-page {
        max-width: 1150px;
        margin: auto;
        padding: 35px 15px 60px;
    }

    /* ===========================
       COVER
    =========================== */

    .profile-cover {
        height: 260px;
        border-radius: 30px;
        overflow: hidden;
        position: relative;
        background: linear-gradient(135deg,#A8D1A3,#7c3aed,#2563eb);
        box-shadow: 0 20px 50px rgba(79,70,229,.25);
    }

        .profile-cover::before {
            content: "";
            position: absolute;
            width: 450px;
            height: 450px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            top: -180px;
            right: -120px;
        }

        .profile-cover::after {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            bottom: -120px;
            left: -90px;
        }

    /* ===========================
       CARD
    =========================== */

    .profile-card {
        background: white;
        margin-top: -90px;
        position: relative;
        border-radius: 30px;
        padding: 40px;
        box-shadow: 0 25px 60px rgba(0,0,0,.08);
    }

    /* ===========================
       PROFILE IMAGE
    =========================== */

    .avatar-wrapper {
        position: relative;
        width: 180px;
        margin: auto;
    }

    .profile-avatar {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        object-fit: cover;
        border: 8px solid white;
        box-shadow: 0 20px 40px rgba(0,0,0,.15);
        transition: .4s;
    }

        .profile-avatar:hover {
            transform: scale(1.05) rotate(3deg);
        }

    /* ONLINE */

    .online-dot {
        position: absolute;
        right: 18px;
        bottom: 15px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #22c55e;
        border: 4px solid white;
        box-shadow: 0 0 15px #22c55e;
    }

    /* ===========================
       NAME
    =========================== */

    .profile-name {
        font-size: 34px;
        font-weight: 800;
        color: #1e293b;
    }

    .profile-email {
        color: #64748b;
        font-size: 16px;
    }

    /* ===========================
       BADGES
    =========================== */

    .profile-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border-radius: 30px;
        background: #eef2ff;
        color: #A8D1A3;
        font-weight: 700;
        margin: 6px;
    }

        .profile-badge i {
            color: #A8D1A3;
        }

    .action-buttons {
        margin-top: 25px;
    }

    .follow-btn {
        border: none;
        padding: 13px 32px;
        border-radius: 14px;
        background: linear-gradient(135deg,#A8D1A3,#7c3aed);
        color: white;
        font-weight: 700;
        transition: .3s;
    }

        .follow-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(79,70,229,.35);
        }

    .message-btn {
        border-radius: 14px;
        padding: 13px 30px;
        font-weight: 700;
    }

</style>

<div class="profile-page">

    <!-- COVER -->

    <div class="profile-cover"></div>

    <!-- PROFILE CARD -->

    <div class="profile-card">

        <div class="row align-items-center">

            <!-- LEFT -->

            <div class="col-lg-4 text-center">

                <div class="avatar-wrapper">

                    <img src="@(string.IsNullOrWhiteSpace(Model.ProfilePicture)
                                          ? "/images/default-user.png"
                                          : Model.ProfilePicture)"
                         class="profile-avatar" />

                  

                </div>

            </div>

            <!-- RIGHT -->

            <div class="col-lg-8">

                <h1 class="profile-name">

                    @Model.FullName

                </h1>

                <div class="profile-email">

                    <i class="fa-solid fa-envelope"></i>

                    @Model.Email

                </div>
                <div class="profile-status mt-2">

                    @if (Model.IsOnline)
                    {
                        <span class="badge bg-success">
                            <i class="fa-solid fa-circle" style="font-size:8px"></i>
                            Online
                        </span>
                    }
                    else if (Model.LastSeen != null)
                    {
                        <small class="text-muted">
                            Last seen @Model.LastSeen.Value.ToString("dd MMM yyyy • hh:mm tt")
                        </small>
                    }
                    else
                    {
                        <small class="text-muted">
                            Offline
                        </small>
                    }

                </div>

                <div class="mt-3">

                    @if (!string.IsNullOrWhiteSpace(Model.Department))
                    {
                        <span class="profile-badge">

                            <i class="fa-solid fa-building-columns"></i>

                            @Model.Department

                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.EnrollmentNo))
                    {
                        <span class="profile-badge">

                            <i class="fa-solid fa-id-card"></i>

                            @Model.EnrollmentNo

                        </span>
                    }

                </div>

                <div class="action-buttons">
                    @if (isFollowing)
                    {
                        <button class="btn btn-success follow-btn">

                            <i class="fa-solid fa-check"></i>
                            Following

                        </button>
                    }
                    else if (isRequestPending)
                    {
                        <button class="btn btn-warning follow-btn" disabled>

                            <i class="fa-solid fa-clock"></i>
                            Request Sent

                        </button>
                    }
                    else
                    {
                        <a asp-controller="Follow"
                           asp-action="Send"
                           asp-route-id="@Model.Id"
                           class="btn follow-btn">

                            <i class="fa-solid fa-user-plus"></i>
                            Follow

                        </a>
                    }
                    <a asp-controller="Message"
                       asp-action="Chat"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-dark message-btn ms-2">

                        <i class="fa-solid fa-paper-plane"></i>
                        Message

                    </a>

                </div>

            </div>

        </div>

        <!-- ===========================
             STATS
        ============================ -->

        <div class="row mt-5 g-4">

            <div class="col-md-4">

                <div class="stats-card text-center">

                    <div class="stats-icon bg-primary">

                        <i class="fa-solid fa-image"></i>

                    </div>

                    <h2>

                        @ViewBag.Posts

                    </h2>

                    <p>

                        Total Posts

                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="stats-card text-center">

                    <div class="stats-icon bg-success">

                        <i class="fa-solid fa-users"></i>

                    </div>

                    <h2>

                        @ViewBag.Followers

                    </h2>

                    <p>

                        Followers

                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="stats-card text-center">

                    <div class="stats-icon bg-danger">

                        <i class="fa-solid fa-user-check"></i>

                    </div>

                    <h2>

                        @ViewBag.Following

                    </h2>

                    <p>

                        Following

                    </p>

                </div>

            </div>

        </div>

        <!-- ===========================
             ABOUT
        ============================ -->

        <div class="about-card mt-5">

            <h3>

                <i class="fa-solid fa-user"></i>

                About Student

            </h3>

            <hr />

            @if (!string.IsNullOrWhiteSpace(Model.Bio))
            {
                <p>

                    @Model.Bio

                </p>
            }
            else
            {
                <div class="alert alert-light border rounded-4">

                    <i class="fa-regular fa-face-smile"></i>

                    This student hasn't added a bio yet.

                </div>
            }

        </div>
    </div>

</div>

<style>

    /* ===========================
       STATS
    =========================== */

    .stats-card {
        background: #fff;
        border-radius: 24px;
        padding: 35px 25px;
        box-shadow: 0 15px 35px rgba(0,0,0,.08);
        transition: .35s;
        height: 100%;
    }

        .stats-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 45px rgba(79,70,229,.18);
        }

    .stats-icon {
        width: 70px;
        height: 70px;
        margin: auto auto 18px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
        font-size: 28px;
    }

    .stats-card h2 {
        font-size: 40px;
        font-weight: 800;
        color: #1f2937;
        margin-bottom: 8px;
    }

    .stats-card p {
        color: #64748b;
        font-weight: 600;
        margin: 0;
    }

    /* ===========================
       ABOUT
    =========================== */

    .about-card {
        background: white;
        border-radius: 25px;
        padding: 35px;
        box-shadow: 0 15px 35px rgba(0,0,0,.08);
    }

        .about-card h3 {
            font-weight: 800;
            color: #1f2937;
            margin-bottom: 15px;
        }

        .about-card p {
            color: #475569;
            line-height: 1.9;
            font-size: 16px;
        }

    /* ===========================
       ANIMATION
    =========================== */

    .profile-card,
    .stats-card,
    .about-card {
        animation: fadeUp .6s ease;
    }

    @@keyframes fadeUp {

        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ===========================
       RESPONSIVE
    =========================== */

    @@media (max - width:991px) {

        .profile-card {
            margin-top: -60px;
            padding: 30px;
        }

        .profile-name {
            margin-top: 20px;
            font-size: 30px;
        }
    }

    @@media (max - width:768px) {

        .profile-cover {
            height: 180px;
        }

        .profile-avatar {
            width: 150px;
            height: 150px;
        }

        .profile-name {
            font-size: 26px;
        }

        .action-buttons .btn {
            width: 100%;
            margin-bottom: 12px;
        }

        .message-btn {
            margin-left: 0 !important;
        }
    }

</style>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
<partial name="_Footer" />
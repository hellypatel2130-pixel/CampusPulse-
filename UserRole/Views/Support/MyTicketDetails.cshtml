@model UserRole.Models.SupportTicket

@{
    ViewData["Title"] = "Ticket Details";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" />

<style>

    body {
        background: #eef4ff;
    }

    .ticket-card {
        max-width: 900px;
        margin: 40px auto;
        background: white;
        border-radius: 25px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0,0,0,.08);
    }

    .ticket-header {
        padding: 35px;
        color: white;
        background: linear-gradient(135deg,#A8D1A3,#7c3aed,#2563eb);
    }

    .info {
        padding: 35px;
    }

        .info h5 {
            font-weight: 700;
            margin-bottom: 18px;
        }

    .status {
        padding: 10px 18px;
        border-radius: 30px;
        font-weight: 700;
        display: inline-block;
    }

    .pending {
        background: #fff3cd;
        color: #856404;
    }

    .progress {
        background: #cfe2ff;
        color: #084298;
    }

    .resolved {
        background: #d1e7dd;
        color: #0f5132;
    }

    .timeline {
        margin-top: 30px;
        border-left: 4px solid #7c3aed;
        padding-left: 25px;
    }

    .timeline-item {
        margin-bottom: 25px;
    }

        .timeline-item h6 {
            font-weight: 700;
            margin-bottom: 4px;
        }

</style>

<div class="ticket-card">

    <div class="ticket-header">

        <h2>

            <i class="fa-solid fa-headset"></i>

            Support Ticket

        </h2>

        <p class="mb-0">

            Track your support request

        </p>

    </div>

    <div class="info">

        <div class="row">

            <div class="col-md-6">

                <h5>Ticket Number</h5>

                <p>@Model.TicketNumber</p>

            </div>

            <div class="col-md-6">

                <h5>Priority</h5>

                <p>@Model.Priority</p>

            </div>

            <div class="col-md-6">

                <h5>Subject</h5>

                <p>@Model.Subject</p>

            </div>

            <div class="col-md-6">

                <h5>Status</h5>

                @if (Model.Status == "Pending")
                {
                    <span class="status pending">

                        Pending

                    </span>
                }
                else if (Model.Status == "In Progress")
                {
                    <span class="status progress">

                        In Progress

                    </span>
                }
                else
                {
                    <span class="status resolved">

                        Resolved

                    </span>
                }

            </div>

        </div>

        <hr />

        <h5>Description</h5>

        <p>

            @Model.Message

        </p>

        <div class="timeline">

            <div class="timeline-item">

                <h6>

                    <i class="fa-solid fa-paper-plane"></i>

                    Ticket Submitted

                </h6>

                <p>

                    @Model.CreatedAt.ToString("dd MMM yyyy hh:mm tt")

                </p>

            </div>

            @if (Model.Status == "In Progress")
            {
                <div class="timeline-item">

                    <h6>

                        <i class="fa-solid fa-spinner"></i>

                        Currently Under Review

                    </h6>

                    <p>

                        Your request is being reviewed by the administrator.

                    </p>

                </div>
            }

            @if (Model.Status == "Resolved")
            {
                <div class="timeline-item">

                    <h6>

                        <i class="fa-solid fa-circle-check"></i>

                        Resolved

                    </h6>

                    <p>

                        Resolved on

                        @(Model.ResolvedAt?.ToString("dd MMM yyyy hh:mm tt"))

                    </p>

                </div>
            }

        </div>

        <a asp-action="MyTickets"
           class="btn btn-primary mt-4">

            <i class="fa-solid fa-arrow-left"></i>

            Back

        </a>

    </div>

</div>

<partial name="_Footer" />
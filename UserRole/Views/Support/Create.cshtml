@model UserRole.Models.SupportTicket

@{
    ViewData["Title"] = "Support Center";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" />

<style>

    body {
        background: #eef4ff;
    }

    .support-container {
        max-width: 850px;
        margin: 50px auto;
    }

    .support-card {
        background: #fff;
        border-radius: 25px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0,0,0,.08);
    }

    .support-header {
        padding: 45px;
        text-align: center;
        color: #fff;
        background: linear-gradient(135deg,#A8D1A3,#7c3aed,#2563eb);
    }

        .support-header h2 {
            font-weight: 800;
            margin-bottom: 10px;
        }

        .support-header p {
            opacity: .95;
            margin: 0;
        }

    .support-body {
        padding: 40px;
    }

    .form-label {
        font-weight: 700;
        color: #374151;
    }

    .form-control,
    .form-select {
        border-radius: 12px;
        padding: 12px 15px;
    }

    textarea {
        resize: none;
    }

    .btn-submit {
        background: linear-gradient(135deg,#A8D1A3,#7c3aed);
        color: #fff;
        border: none;
        padding: 12px 35px;
        border-radius: 12px;
        font-weight: 700;
    }

    .btn-reset {
        border-radius: 12px;
        padding: 12px 35px;
        font-weight: 700;
    }

</style>

<div class="support-container">

    <div class="support-card">

        <div class="support-header">

            <h2>
                <i class="fa-solid fa-headset"></i>
                Campus Support
            </h2>

            <p>
                Facing any issue? Send your problem directly to the administrator.
            </p>

        </div>

        <div class="support-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">

                    <i class="fa-solid fa-circle-check"></i>

                    @TempData["Success"]

                </div>
            }

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Name"
                               class="form-label"></label>

                        <input asp-for="Name"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label"></label>

                        <input asp-for="Email"
                               class="form-control"
                               readonly />

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="Subject"
                           class="form-label"></label>

                    <input asp-for="Subject"
                           class="form-control"
                           placeholder="Enter subject" />

                    <span asp-validation-for="Subject"
                          class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="Priority"
                           class="form-label"></label>

                    <select asp-for="Priority"
                            class="form-select">

                        <option value="">Select Priority</option>

                        <option>Low</option>

                        <option>Medium</option>

                        <option>High</option>

                    </select>

                    <span asp-validation-for="Priority"
                          class="text-danger"></span>

                </div>

                <div class="mb-4">

                    <label asp-for="Message"
                           class="form-label"></label>

                    <textarea asp-for="Message"
                              rows="6"
                              class="form-control"
                              placeholder="Describe your problem here..."></textarea>

                    <span asp-validation-for="Message"
                          class="text-danger"></span>

                </div>

                <button type="submit"
                        class="btn btn-submit">

                    <i class="fa-solid fa-paper-plane"></i>

                    Submit Ticket

                </button>

                <button type="reset"
                        class="btn btn-secondary btn-reset ms-2">

                    <i class="fa-solid fa-rotate-left"></i>

                    Reset

                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<partial name="_Footer" />